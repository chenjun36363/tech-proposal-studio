# Dependencies
node_modules/

# Frontend build and test output
dist/
output/
coverage/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Rust / Tauri build output
src-tauri/target/
src-tauri/tauri.version.generated.conf.json

# Local environment and secrets
*.local
.env
.env.*
!.env.example
.claude/settings.local.json

# Local agent and browser-tool state
.workbuddy/
.playwright-cli/
.playwright-mcp/
.tmp/

# Workspace runtime data when a workspace is created inside the repository
workspace/.gouan/
**/.gouan/*.db
**/.gouan/*.db-shm
**/.gouan/*.db-wal

# Keep the Git-friendly conversation history file trackable in repository workspaces
!workspace/.gouan/
!workspace/.gouan/agent-conversations.json

# Logs and process artifacts
*.log
*.pid
*.stdout
*.stderr

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
